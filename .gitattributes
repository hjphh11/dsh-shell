# Normalize line endings in the repository, independent of contributor OS.
# Without this, git rewrites CRLF/LF on every checkout and diffs churn.
* text=auto eol=lf

# Windows-only binaries must not be touched.
*.ico binary
*.png binary
*.jpg binary

# Keep PowerShell scripts CRLF: some Windows tooling is happier with it, and
# these are the entry points users run directly.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
